{
  "protocol": "mapper-cases-v1",
  "oracle_provenance": "expected_output records were independently authored from the frozen raw mapping profile and the accepted calibration-v1 C0 schema, not captured from mapper execution. The Rust mapper never reads this file.",
  "request_grammar": {
    "required_envelope": [
      "profile_version",
      "dataset_id",
      "mapping_version",
      "origin_utc",
      "case_key_field",
      "source_family",
      "shape",
      "event_bindings",
      "rows"
    ],
    "profile_version": "c11.synthetic-map-v1",
    "shape": "wide expands ordered bindings; long requires event_kind_field and expands exactly the named binding",
    "binding": {
      "kind": "nonempty id",
      "rank": "canonical ASCII unsigned decimal string",
      "occurrence_index": "UInt32",
      "occurrence_field": "row field",
      "key_field": "row field",
      "order_field": "UInt64 row field",
      "source_event_type": "optional literal synthetic source label",
      "recorded_field": "optional row field",
      "message_field": "optional row field",
      "knowledge_field": "optional row object with status and available_at",
      "movement_evidence_field": "optional row field",
      "interval_field": "optional row object with start_ticks and nullable end_ticks"
    },
    "clock": {
      "raw": "nonempty RFC3339 string or canonical signed integer string",
      "representation": "RFC3339 | relative_integer | classified (requires synthetic classifier provenance)",
      "precision": "minute | second | millisecond | microsecond | nanosecond | other",
      "lineage": "status; mapping_version is added from the declared profile mapping version; optional evidence_ref/derivation retained",
      "unit": "s | ms | us | ns only for relative_integer"
    },
    "outcome": {
      "required_fields": [
        "endpoint",
        "risk_start",
        "last_observed",
        "event_clock",
        "censor_cause",
        "censor_status",
        "lineage"
      ],
      "rule": "Only explicit clocks map; right censoring has a required last_observed and null event_clock."
    },
    "output": "C0 trace_event/exclusion records and outcome_observation records; candidate accounting is event-only and conserves accepted+excluded+failed+unresolved units"
  },
  "raw_requests": [
    {
      "case_id": "wide_utc_positive",
