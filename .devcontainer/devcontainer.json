{
  "name": "KairoECS polyglot dev",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15.2"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24.22.1"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    }
  },
  "postCreateCommand": "rustup toolchain install 1.99.1 --component clippy --component rustfmt && python3.15 scripts/python_runtime.py && cargo install cargo-nextest --locked && cargo install cargo-vet --locked && cargo install just --locked",
  "remoteEnv": {
    "RUSTUP_TOOLCHAIN": "1.99.1",
    "CARGO_HOME": "/usr/local/cargo"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "golang.Go",
        "ms-dotnettools.csharp"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
