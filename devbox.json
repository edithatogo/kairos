{
  "$schema": "https://raw.githubusercontent.com/jetpack-io/devbox/0.12.0/.schema/devbox.schema.json",
  "packages": [
    "rustup",
    "pkg-config",
    "openssl",
    "uv",
    "nodejs",
    "go",
    "julia",
    "R",
    "dotnet-sdk_10",
    "just",
    "cargo-nextest",
    "cargo-vet"
  ],
  "shell": {
    "init_hook": [
      "echo 'KairoECS devbox environment ready'",
      "rustup component add clippy rustfmt >/dev/null 2>&1 || true",
      "test -d .venv || uv venv --python 3.15.1 .venv",
      "source .venv/bin/activate",
      "python scripts/python_runtime.py"
    ],
    "scripts": {
      "test": [
        "just test"
      ],
      "validate": [
        "just dev-validate"
      ]
    }
  }
}
