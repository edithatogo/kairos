--- /dev/null
+++ b/crates/kairo-ecs-grpc/tests/track97_probe.rs
@@ -0,0 +1,112 @@
+use kairo_ecs_grpc::{GrpcPeer, GrpcTransportConfig, TonicTransport};
+use kairo_ecs_pdes::{LpId, PdesTransport, Tick};
+use std::{
+    collections::BTreeMap,
+    sync::{Arc, Mutex},
+    thread,
+    time::{Duration, Instant},
+};
+use tracing::{
+    field::{Field, Visit},
+    span::{Attributes, Id, Record},
+    Event, Metadata, Subscriber,
+};
+
+#[derive(Default)]
+struct Fields(BTreeMap<String, u64>);
+impl Visit for Fields {
+    fn record_u64(&mut self, field: &Field, value: u64) {
+        self.0.insert(field.name().to_owned(), value);
+    }
+    fn record_debug(&mut self, _: &Field, _: &dyn std::fmt::Debug) {
+        panic!("unexpected nonnumeric field");
+    }
+}
+struct Sink {
+    run: u64,
+    seen: Arc<Mutex<Vec<(u64, Fields)>>>,
+    caller: thread::ThreadId,
+}
+impl Subscriber for Sink {
+    fn enabled(&self, m: &Metadata<'_>) -> bool {
+        m.target() == "kairos::gvt"
+    }
+    fn new_span(&self, _: &Attributes<'_>) -> Id {
+        Id::from_u64(1)
+    }
+    fn record(&self, _: &Id, _: &Record<'_>) {}
+    fn record_follows_from(&self, _: &Id, _: &Id) {}
+    fn enter(&self, _: &Id) {}
+    fn exit(&self, _: &Id) {}
+    fn event(&self, e: &Event<'_>) {
+        assert_eq!(thread::current().id(), self.caller);
+        let mut fields = Fields::default();
+        e.record(&mut fields);
+        let start = Instant::now();
+        thread::sleep(Duration::from_millis(40));
+        assert!(start.elapsed() >= Duration::from_millis(40));
+        self.seen.lock().unwrap().push((self.run, fields));
+    }
+}
+
+fn run(complete: bool) -> Tick {
+    let addr = "127.0.0.1:0".parse().unwrap();
+    let mut peer =
+        TonicTransport::bind(LpId(2), addr, vec![], GrpcTransportConfig::default()).unwrap();
+    let config = GrpcTransportConfig {
+        request_timeout: Duration::from_millis(100),
+        ..Default::default()
+    };
+    let mut local = TonicTransport::bind(
+        LpId(1),
+        addr,
+        vec![GrpcPeer {
+            lp_id: LpId(2),
+            endpoint: format!("http://{}", peer.bound_addr()),
+        }],
+        config,
+    )
+    .unwrap();
+    if complete {
+        // Use a real Tonic sender configured to submit the peer's zero.
+        let source = TonicTransport::bind(
+            LpId(2),
+            addr,
+            vec![GrpcPeer {
+                lp_id: LpId(1),
+                endpoint: format!("http://{}", local.bound_addr()),
+            }],
+            GrpcTransportConfig::default(),
+        )
+        .unwrap();
+        source.propose_gvt(LpId(1), 0, Tick::ZERO).unwrap();
+    }
+    let result = local.all_reduce_min(Tick::from_ticks(500));
+    assert!(peer.recv(LpId(2)).unwrap().is_empty());
+    result
+}
+#[test]
+fn distinguish_silence_from_a_zero_proposal() {
+    assert_eq!([run(false), run(true)], [Tick::ZERO; 2]);
+    let seen = Arc::new(Mutex::new(Vec::new()));
+    let observed = tracing::subscriber::with_default(
+        Sink {
+            run: 97,
+            seen: seen.clone(),
+            caller: thread::current().id(),
+        },
+        || [run(false), run(true)],
+    );
+    assert_eq!(observed, [Tick::ZERO; 2]);
+    let rows = seen.lock().unwrap();
+    assert_eq!(rows.len(), 1);
+    assert_eq!(rows[0].0, 97);
+    assert_eq!(
+        rows[0].1 .0,
+        BTreeMap::from([
+            ("worker".into(), 1),
+            ("round".into(), 0),
+            ("missing_peer".into(), 2)
+        ])
+    );
+}
