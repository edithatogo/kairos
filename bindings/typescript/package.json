{
  "name": "@kairo-ecs/typescript",
  "version": "0.1.0",
  "description": "TypeScript/Wasm binding surface for Kairo ECS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
