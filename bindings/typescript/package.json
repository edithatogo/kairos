{
  "name": "@kairo-ecs/typescript",
  "version": "0.1.0",
  "description": "TypeScript/Wasm binding surface for Kairo ECS",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --pool=threads",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "playwright": "^1.59.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
