{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edithatogo/kairos/main/schemas/arrow/event_log_v2.schema.json",
  "title": "kairo_ecs.event_log.v2",
  "description": "Standard Polars/Arrow columnar schema for KairoECS simulation event logs with explicit generational IDs and full-range 128-bit tick limbs",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "event_id_index",
    "event_id_gen",
    "time_ticks_hi",
    "time_ticks_lo",
    "time_scale",
    "priority",
    "sequence",
    "event_kind",
    "status"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "run_id": { "type": "string" },
    "event_id_index": { "type": "integer", "minimum": 0 },
    "event_id_gen": { "type": "integer", "minimum": 0 },
    "entity_id_index": { "type": ["integer", "null"], "minimum": 0 },
    "entity_id_gen": { "type": ["integer", "null"], "minimum": 0 },
    "time_ticks_hi": { "type": "integer", "minimum": 0 },
    "time_ticks_lo": { "type": "integer", "minimum": 0 },
    "time_scale": { "type": "string" },
    "priority": { "type": "integer" },
    "sequence": { "type": "integer", "minimum": 0 },
    "event_kind": { "type": "string" },
    "status": { "type": "string", "enum": ["dispatched", "cancelled", "skipped", "error"] },
    "payload_ref": { "type": ["string", "null"] }
  }
}
