{
  "schema_version": 1,
  "release_stage": "r2-dry-run",
  "production_publish_enabled": false,
  "output": {
    "artifact_manifest": "dist/release-artifact-manifest.json",
    "checksum_manifest": "dist/SHA256SUMS"
  },
  "local_dry_run_sequence": {
    "sequence_id": "track15-r2-local-registry-package-dry-run",
    "scope": "offline package inventory and local evidence generation only",
    "publish_manifests_allowed": false,
    "steps": [
      {
        "order": 1,
        "name": "validate package inventory",
        "command": "python packaging/scripts/build_release_manifest.py --check",
        "network_required": false,
        "writes": []
      },
      {
        "order": 2,
        "name": "generate local release evidence",
        "command": "python packaging/scripts/build_release_manifest.py --version 0.0.0-r2-dry-run",
        "network_required": false,
        "writes": [
          "dist/release-artifact-manifest.json",
          "dist/SHA256SUMS"
        ]
      },
      {
        "order": 3,
        "name": "validate offline dry-run gate",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File conductor/tracks/15-packaging-publishing-delivery/validate-packaging-dry-run.ps1",
        "network_required": false,
        "writes": []
      }
    ]
  },
  "surfaces": [
    {
      "ecosystem": "rust",
      "surface": "Rust workspace crates",
      "registry": "crates.io",
      "registry_mode": "dry-run",
      "fallback": "GitHub Releases source archive",
      "dry_run_commands": [
        "cargo metadata --no-deps --format-version 1",
        "cargo package --allow-dirty --workspace"
      ],
      "manifests": [
        { "package": "workspace", "path": "Cargo.toml" },
        { "package": "kairo-ecs-abm", "path": "crates/kairo-ecs-abm/Cargo.toml" },
        { "package": "kairo-ecs-arrow", "path": "crates/kairo-ecs-arrow/Cargo.toml" },
        { "package": "kairo-ecs-bench", "path": "crates/kairo-ecs-bench/Cargo.toml" },
        { "package": "kairo-ecs-cli", "path": "crates/kairo-ecs-cli/Cargo.toml" },
        { "package": "kairo-ecs-core", "path": "crates/kairo-ecs-core/Cargo.toml" },
        { "package": "kairo-ecs-debug", "path": "crates/kairo-ecs-debug/Cargo.toml" },
        { "package": "kairo-ecs-des", "path": "crates/kairo-ecs-des/Cargo.toml" },
        { "package": "kairo-ecs-diplomat", "path": "crates/kairo-ecs-diplomat/Cargo.toml" },
        { "package": "kairo-ecs-ffi", "path": "crates/kairo-ecs-ffi/Cargo.toml" },
        { "package": "kairo-ecs-fmi", "path": "crates/kairo-ecs-fmi/Cargo.toml" },
        { "package": "kairo-ecs-gpu", "path": "crates/kairo-ecs-gpu/Cargo.toml" },
        { "package": "kairo-ecs-grpc", "path": "crates/kairo-ecs-grpc/Cargo.toml" },
        { "package": "kairo-ecs-ml", "path": "crates/kairo-ecs-ml/Cargo.toml" },
        { "package": "kairo-ecs-mpi", "path": "crates/kairo-ecs-mpi/Cargo.toml" },
        { "package": "kairo-ecs-pdes", "path": "crates/kairo-ecs-pdes/Cargo.toml" },
        { "package": "kairo-ecs-rng", "path": "crates/kairo-ecs-rng/Cargo.toml" },
        { "package": "kairo-ecs-state", "path": "crates/kairo-ecs-state/Cargo.toml" },
        { "package": "kairo-ecs-streaming", "path": "crates/kairo-ecs-streaming/Cargo.toml" },
        { "package": "kairo-ecs-types", "path": "crates/kairo-ecs-types/Cargo.toml" },
        { "package": "kairo-ecs-uniffi", "path": "crates/kairo-ecs-uniffi/Cargo.toml" },
        { "package": "kairo-ecs-viz", "path": "crates/kairo-ecs-viz/Cargo.toml" },
        { "package": "kairo-ecs-wasm", "path": "crates/kairo-ecs-wasm/Cargo.toml" },
        { "package": "kairo-ecs-webgpu", "path": "crates/kairo-ecs-webgpu/Cargo.toml" }
      ]
    },
    {
      "ecosystem": "python",
      "surface": "Python binding",
      "registry": "TestPyPI",
      "registry_mode": "metadata-check-first",
      "fallback": "GitHub Releases wheel/sdist artifact",
      "dry_run_commands": [
        "python -m build",
        "twine check dist/*"
      ],
      "manifests": [
        { "package": "kairo-ecs", "path": "bindings/python/pyproject.toml" }
      ]
    },
    {
      "ecosystem": "r",
      "surface": "R binding",
      "registry": "R-universe",
      "registry_mode": "source-package-check-first",
      "fallback": "GitHub Releases source package",
      "dry_run_commands": [
        "R CMD build .",
        "R CMD check --no-manual --as-cran *.tar.gz"
      ],
      "manifests": [
        { "package": "kairoECS", "path": "bindings/r/DESCRIPTION" }
      ]
    },
    {
      "ecosystem": "julia",
      "surface": "Julia binding",
      "registry": "Julia dev registry",
      "registry_mode": "metadata-and-test-first",
      "fallback": "GitHub Releases source tree",
      "dry_run_commands": [
        "julia --project=. -e \"using Pkg; Pkg.instantiate(); Pkg.test()\""
      ],
      "manifests": [
        { "package": "KairoECS", "path": "bindings/julia/Project.toml" }
      ]
    },
    {
      "ecosystem": "typescript",
      "surface": "TypeScript/Wasm binding",
      "registry": "npm",
      "registry_mode": "pack-dry-run",
      "fallback": "GitHub Releases npm tarball",
      "dry_run_commands": [
        "npm ci",
        "npm run typecheck",
        "npm test",
        "npm pack --dry-run"
      ],
      "manifests": [
        { "package": "@kairo-ecs/typescript", "path": "bindings/typescript/package.json" }
      ]
    },
    {
      "ecosystem": "csharp",
      "surface": "C# binding",
      "registry": "NuGet",
      "registry_mode": "local-pack-first",
      "fallback": "GitHub Releases nupkg artifact",
      "dry_run_commands": [
        "dotnet restore bindings/csharp/Kairo.ECS.sln",
        "dotnet test bindings/csharp/Kairo.ECS.sln -c Release --no-restore",
        "dotnet pack bindings/csharp/Kairo.ECS.sln -c Release"
      ],
      "manifests": [
        { "package": "Kairo.ECS", "path": "bindings/csharp/src/Kairo.ECS/Kairo.ECS.csproj" },
        { "package": "Kairo.ECS.sln", "path": "bindings/csharp/Kairo.ECS.sln" }
      ]
    },
    {
      "ecosystem": "go",
      "surface": "Go binding",
      "registry": "Go module proxy",
      "registry_mode": "semantic-tag-rehearsal",
      "fallback": "GitHub Releases source archive",
      "dry_run_commands": [
        "go test ./...",
        "go vet ./..."
      ],
      "manifests": [
        { "package": "github.com/edithatogo/kairos/bindings/go", "path": "bindings/go/go.mod" }
      ]
    }
  ]
}
