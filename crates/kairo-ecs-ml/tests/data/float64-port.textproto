ir_version: 8
producer_name: "KairoECS"
opset_import { version: 13 }
graph {
  name: "float64-port"
  input { name: "state" type { tensor_type { elem_type: 11 shape { dim { dim_value: 1 } } } } }
  node { op_type: "Identity" input: "state" output: "next" }
  output { name: "next" type { tensor_type { elem_type: 11 shape { dim { dim_value: 1 } } } } }
}
