{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>edithatogo/renovate-config"
  ],
  "dependencyDashboard": true,
  "timezone": "Australia/Brisbane",
  "schedule": ["before 6am on Monday"],
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "rangeStrategy": "bump",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": []
  },
  "packageRules": [
    {
      "description": "Keep dependency PRs manual until required CI checks are configured",
      "matchUpdateTypes": ["digest", "pin", "patch"],
      "automerge": false,
      "platformAutomerge": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^MSTest\\./",
        "Microsoft.NET.Test.Sdk"
      ],
      "groupName": "dotnet-test-dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Rust patch and minor dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "javascript-packages"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go-modules"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "python-packages"
    }
  ]
}
