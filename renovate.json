{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "dependencyDashboard": true,
  "timezone": "Australia/Sydney",
  "schedule": [
    "* 0-8 * * 1"
  ],
  "prConcurrentLimit": 10,
  "prHourlyLimit": 4,
  "rangeStrategy": "bump",
  "labels": [
    "dependencies"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": [
      "security",
      "dependencies"
    ],
    "schedule": []
  },
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^MSTest\\./",
        "Microsoft.NET.Test.Sdk"
      ],
      "groupName": "dotnet-test-dependencies"
    },
    {
      "matchManagers": [
        "cargo"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "groupName": "Rust patch and minor dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "javascript-packages"
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "groupName": "go-modules"
    },
    {
      "matchDatasources": [
        "pypi"
      ],
      "groupName": "python-packages"
    }
  ]
}
