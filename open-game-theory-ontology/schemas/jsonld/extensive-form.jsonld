{
  "@context": {
    "gt": "https://kairos.dev/ontology/game-theory#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "type": "@type",
    "id": "@id"
  },
  "@graph": [
    {
      "id": "gt:DecisionNode",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:ChanceNode",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:TerminalNode",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:InformationSet",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:Action",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:Transition",
      "type": "rdfs:Class"
    },
    {
      "id": "gt:transitionTo",
      "type": "rdfs:Property",
      "rdfs:domain": "gt:Action",
      "rdfs:range": "gt:Transition"
    }
  ]
}
