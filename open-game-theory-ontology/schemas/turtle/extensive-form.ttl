@prefix gt: <https://kairos.dev/ontology/game-theory#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

gt:DecisionNode a rdfs:Class .
gt:ChanceNode a rdfs:Class .
gt:TerminalNode a rdfs:Class .
gt:InformationSet a rdfs:Class .
gt:Action a rdfs:Class .
gt:Transition a rdfs:Class .
gt:hasAction a rdfs:Property ; rdfs:domain gt:DecisionNode ; rdfs:range gt:Action .
gt:transitionTo a rdfs:Property ; rdfs:domain gt:Action ; rdfs:range gt:Transition .
gt:inInformationSet a rdfs:Property ; rdfs:domain gt:DecisionNode ; rdfs:range gt:InformationSet .
